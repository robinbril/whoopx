# WHOOP mode: "demo" uses local fixtures (no auth needed), "live" hits the real API.
WHOOP_MODE=demo

# Required only when WHOOP_MODE=live.
WHOOP_EMAIL=
WHOOP_PASSWORD=

# Optional: pin a stable installation identifier (uppercase UUID).
# If unset, a random UUID is generated per process.
# WHOOP_INSTALLATION_ID=

# Optional: IANA timezone override (e.g. Europe/Amsterdam).
# Defaults to the host's system timezone.
# WHOOP_TIMEZONE=
